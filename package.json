{
  "name": "mindgate-mcp",
  "version": "1.1.0",
  "description": "MindGate (بوابة العقل) — Local-first, Node2Shell-hardened Model Context Protocol (MCP) memory & context gateway for Antigravity, OpenCode, Codex, Cursor, and Claude.",
  "author": "Ahmed Adel (aaserag1)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaserag1/mindgate-mcp.git"
  },
  "homepage": "https://github.com/aaserag1/mindgate-mcp#readme",
  "bugs": {
    "url": "https://github.com/aaserag1/mindgate-mcp/issues"
  },
  "bin": {
    "mindgate-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ar.md",
    "AGENTS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
