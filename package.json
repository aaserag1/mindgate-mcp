{
  "name": "mindgate-mcp",
  "version": "1.0.0",
  "description": "MindGate (بوابة العقل) — Local-first, Node2Shell-hardened Model Context Protocol (MCP) memory & context gateway for Antigravity, OpenCode, Codex, and AI coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mindgate-mcp": "./dist/index.js"
  },
  "files": [
